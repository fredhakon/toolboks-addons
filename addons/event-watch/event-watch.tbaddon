{
  "schema_version": 1,
  "manifest": {
    "id": "toolboks.event-watch",
    "title": "Event Watch",
    "native_provider": "toolboks.event-watch",
    "description": "Understand Windows events and crashes.",
    "long_description": "Event Watch reads the Windows event logs and explains what is going on, with a closer look at crashes and restarts. It reads crash dump headers to name the stop code. It never clears your logs and changes nothing on your PC.",
    "version": "0.1.0",
    "author": "Toolboks team",
    "publisher": "Toolboks",
    "category": "System tools",
    "icon": "grid",
    "accent": "#A48ACA",
    "api_version": 2,
    "min_toolboks_version": "0.12.5",
    "website": "https://github.com/Gusseti/toolboks",
    "support_url": "https://github.com/Gusseti/toolboks/issues",
    "license": "MIT",
    "capabilities": [
      "filesystem_read",
      "local_preferences"
    ]
  },
  "pages": []
}
