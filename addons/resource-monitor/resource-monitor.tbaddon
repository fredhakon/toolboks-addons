{
  "schema_version": 1,
  "manifest": {
    "id": "toolboks.resource-monitor",
    "title": "Resource Monitor",
    "native_provider": "toolboks.resource-monitor",
    "description": "Watch your processor, graphics, memory, disk and network.",
    "long_description": "Resource Monitor draws live graphs of what your PC is doing and keeps a short history while it is open. It also lists running apps, lets you change a process's priority or end it, and shows network connections. It reads system and process information; it changes something only when you use one of those process actions.",
    "version": "0.1.0",
    "author": "Toolboks team",
    "publisher": "Toolboks",
    "category": "System tools",
    "icon": "activity",
    "accent": "#A48ACA",
    "api_version": 2,
    "min_toolboks_version": "0.12.5",
    "website": "https://github.com/Gusseti/toolboks",
    "support_url": "https://github.com/Gusseti/toolboks/issues",
    "license": "MIT",
    "capabilities": [
      "host_metrics"
    ]
  },
  "pages": []
}
