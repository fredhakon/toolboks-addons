{
  "schema_version": 1,
  "manifest": {
    "id": "toolboks.debloater",
    "title": "Debloater",
    "native_provider": "toolboks.debloater",
    "description": "Tune Windows privacy, apps, startup and background tasks.",
    "long_description": "Debloater explains optional Windows changes in plain language, so you can turn off what you do not need. Nothing is changed until you choose it, and supported changes can be undone during the session. It changes your own account's settings: privacy and advertising switches, startup entries and installed apps. Changes that need administrator rights are listed but not available yet. The Startup page shows how much slower Windows measured an entry to start, read from Windows' boot performance log; it is read in memory only and nothing is saved. Windows only lets administrators read that log on a default PC, and an administrator can allow reading in the log's access list (Toolboks never changes it).",
    "version": "0.1.0",
    "author": "Toolboks team",
    "publisher": "Toolboks",
    "category": "System tools",
    "icon": "sliders",
    "accent": "#A48ACA",
    "api_version": 2,
    "min_toolboks_version": "0.12.5",
    "website": "https://github.com/Gusseti/toolboks",
    "support_url": "https://github.com/Gusseti/toolboks/issues",
    "license": "MIT",
    "capabilities": [
      "system_tuning"
    ]
  },
  "pages": []
}
