{
  "schema_version": 1,
  "manifest": {
    "id": "toolboks.disk-manager",
    "title": "Disk Manager",
    "byline": "by stratum",
    "native_provider": "stratum.disk-manager",
    "description": "Map storage and find large files. Keeps your last scan of each drive on this PC. Saved file names stay local; remembering scans can be turned off.",
    "long_description": "Stratum's disk analysis, built for your Toolboks workspace. Scan any drive or folder, explore an interactive space map, find the largest files, filter by size and age, inspect file types, and export your findings. Analyze fragmentation, inspect Windows optimization history, defragment hard drives, or TRIM SSDs with administrator access. Optimization only runs when requested. Scans are read-only, run in the background, and can be cancelled. Right-click a file or folder to show it in Explorer or delete it permanently: deleting asks first, skips the Recycle Bin, runs as you (never as administrator), and refuses drive roots, Windows and Program Files. Links and junctions are skipped; access errors are reported transparently. Sizes are logical file lengths and may differ from allocated disk usage. Drive-changing optimization (defrag and TRIM) is made by a small separate helper that shows its own Confirm or Cancel window; Disk Manager itself never runs as administrator. Keeps your last scan of each drive on this PC, in the add-on data folder, never in preferences or online. Turn off Remember my last scan or use Delete saved scans to remove saved file names. Quick rescans compare folder times; in-place file size changes require Full rescan. Drive optimization also shows drive health (Healthy, Watch or Replace soon) from the NVMe health log or SATA SMART data, with the raw values one click away; drives that only report health to administrators are named as such. Drives behind a RAID controller (Intel RST or VMD) give no such data, so Disk Manager shows the rating Windows itself gives them (Healthy, Warning or Unhealthy) and says plainly that detailed values are not available. It also reports each fixed drive's health and free space to Home, kept in memory only: health is read again every six hours, free space every five minutes.",
    "version": "0.9.0",
    "author": "Stratum",
    "publisher": "Toolboks",
    "category": "Storage",
    "icon": "storage",
    "accent": "#A48ACA",
    "api_version": 2,
    "min_toolboks_version": "0.15.0",
    "license": "MIT",
    "capabilities": [
      "filesystem_read",
      "local_preferences",
      "user_exports",
      "drive_optimize"
    ],
    "data_note": "Keeps your last scan of each drive on this PC (file and folder names).",
    "checks": [
      "Drive health",
      "Free space"
    ]
  },
  "pages": []
}
